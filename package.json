{
  "name": "r-debugger-watcher",
  "displayName": "R Debugger Watcher",
  "description": "Monitors R files for interactive debugger calls like browser()",
  "repository": {
    "type": "git",
    "url": "https://github.com/T-Hazell/vsc_is_browser.git"
  },
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:r"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rDebuggerWatcher.jumpToDebugger",
        "title": "Jump to Debugger Call"
      }
    ],
    "configuration": {
      "title": "R Debugger Watcher",
      "properties": {
        "rDebuggerWatcher.cleanStateText": {
          "type": "string",
          "default": "B",
          "description": "Text or Icon (e.g., $(check)) to show when no debuggers are detected."
        },
        "rDebuggerWatcher.cleanStateColor": {
          "type": "string",
          "default": "#55ff55",
          "description": "Color of the status bar item when no debuggers are detected."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^16.x",
    "@types/vscode": "^1.75.0",
    "typescript": "^4.9.5"
  }
}
